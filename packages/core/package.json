{
  "name": "@forkpoint/agent-lighthouse-core",
  "version": "0.4.0",
  "description": "Core TypeScript engine for auditing websites for AI-agent readiness, LLM crawler access, MCP discovery, structured data, and agentic web signals",
  "author": "ForkPoint",
  "license": "Apache-2.0",
  "homepage": "https://forkpoint.github.io/agent-lighthouse/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ForkPoint/agent-lighthouse.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ForkPoint/agent-lighthouse/issues"
  },
  "keywords": [
    "forkpoint",
    "agent-lighthouse",
    "lighthouse",
    "ai-agents",
    "agentic-web",
    "webmcp",
    "mcp",
    "openapi",
    "structured-data",
    "schema-org",
    "llms-txt",
    "robots-txt",
    "ai-seo",
    "crawler",
    "agent-readiness",
    "aeo",
    "geo",
    "seo",
    "audit",
    "ecommerce"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "domhandler": "^5.0.3",
    "jsdom": "^29.1.1",
    "undici": "^6.21.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/domhandler": "^2.4.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
