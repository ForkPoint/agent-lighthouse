{
  "name": "@forkpoint/agent-lighthouse-core",
  "version": "5.0.0",
  "description": "Core TypeScript engine for auditing websites for AI-agent readiness, LLM crawler access, MCP discovery, structured data, and agentic web signals",
  "author": "ForkPoint",
  "license": "Apache-2.0",
  "homepage": "https://forkpoint.github.io/agent-lighthouse/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ForkPoint/agent-lighthouse.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ForkPoint/agent-lighthouse/issues"
  },
  "keywords": [
    "forkpoint",
    "agent-lighthouse",
    "lighthouse",
    "ai-agents",
    "agentic-web",
    "webmcp",
    "mcp",
    "openapi",
    "structured-data",
    "schema-org",
    "llms-txt",
    "robots-txt",
    "ai-seo",
    "crawler",
    "agent-readiness",
    "aeo",
    "geo",
    "seo",
    "audit",
    "ecommerce"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./migration-map.json": "./migration-map.json"
  },
  "files": [
    "dist",
    "migration-map.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.0.0",
    "domhandler": "^6.0.1",
    "gpt-tokenizer": "^4.0.0",
    "jsdom": "^30.1.1",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/domhandler": "^3.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
