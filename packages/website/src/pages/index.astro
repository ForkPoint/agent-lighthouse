---
import Base from '../layouts/Base.astro';
import { categoryList } from '../lib/registry';
import { benefits } from '../lib/product-copy';
import { categoryPath, docPath, withBase } from '../lib/routes';
import {
  BADGE_BANDS,
  DEFAULT_SCORE,
  DEFAULT_URL,
  badgeMarkdown,
} from '../islands/badge-generator';

/** The product homepage keeps scan entry points ahead of technical reference. */
const categories = categoryList();

// The install line, rendered as text so it needs nothing to be readable.
const installCommand = 'npx @forkpoint/agent-lighthouse https://yourstore.com';

// Shown before any script runs, and replaced by the same function afterwards.
const defaultBadge = badgeMarkdown(DEFAULT_SCORE, DEFAULT_URL);

const card = 'rounded-xl border border-border-subtle bg-surface-raised p-5';
const panel = 'rounded-2xl border border-border-subtle bg-surface-raised p-5 sm:p-6';
const field =
  'mt-2 w-full rounded-lg border border-control bg-surface px-3 py-2 text-sm text-ink placeholder:text-muted focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand';
const label = 'block text-xs font-semibold uppercase tracking-wider text-muted';
const sectionHead = 'border-b border-border-subtle pb-4';
const h2 = 'text-2xl font-bold tracking-tight text-ink';
---
<Base
  title="Agent Lighthouse — Check your website’s AI readiness"
  description="Agent Lighthouse is an open-source tool for website AI readiness. Run your own scan to find gaps in discovery, content and actions. Get clear findings and next steps."
>

  <section data-pagefind-body class="hero-section border-b border-border-subtle">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-[1.3fr_1fr] lg:px-8">
      <div>
        <p class="eyebrow">Open source. Built for AI readiness.</p>
        <h1 class="hero-title mt-5">Find what stands between <em>AI and your website.</em></h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-body">Agent Lighthouse is an open-source tool that checks how easily AI systems can find, understand, trust and use your site. Run your own scan. Get clear findings and practical next steps.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={docPath('quickstart')} class="primary-action">Run your first scan <span aria-hidden="true">→</span></a>
          <a href="https://github.com/ForkPoint/agent-lighthouse" class="secondary-action">View on GitHub <span aria-hidden="true">↗</span></a>
        </div>
        <p class="mt-4 text-sm text-muted">Free to use. Apache-2.0 licensed. Run it from your terminal or add it to your workflow.</p>
      </div>
      <aside class="readiness-preview" aria-label="What a scan covers">
        <div class="flex items-center justify-between gap-3 border-b border-border-subtle pb-5"><span class="eyebrow">A clearer view of your site</span><span class="preview-mark" aria-hidden="true">↗</span></div>
        <h2 class="mt-6 text-2xl font-bold text-ink">Can AI work with your website?</h2>
        <ol class="mt-5">
          {['Find your pages', 'Read and cite your content', 'Understand products and actions', 'Show you what needs attention'].map((item, i) => <li class="flex items-center gap-4 border-b border-border-subtle py-4"><span class="step-number">0{i + 1}</span><span class="text-sm font-medium text-ink">{item}</span></li>)}
        </ol>
        <p class="mt-5 text-xs leading-relaxed text-muted">Checks website signals. Does not guarantee AI mentions, citations or completed actions.</p>
      </aside>
    </div>
  </section>
  <div class="mx-auto max-w-7xl space-y-20 px-4 py-14 sm:px-6 lg:px-8">
    <section aria-labelledby="audience-heading" class="audience-strip">
      <h2 id="audience-heading" class="text-sm font-semibold text-ink">For teams that depend on their website</h2>
      <p class="text-sm text-muted">Website owners · Marketing teams · SaaS products · Online shops · Documentation teams</p>
    </section>
    <section id="what-you-get" aria-labelledby="benefits-heading">
      <p class="eyebrow">From questions to next steps</p>
      <h2 id="benefits-heading" class="section-title mt-3">See where your website <em>needs work.</em></h2>
      <p class="mt-3 max-w-2xl text-body">One scan brings the key signals together. Review the findings that fit your site and your goals.</p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {benefits.map((benefit, index) => <li class="benefit-card"><div class="benefit-kicker"><p class="eyebrow">{benefit.label}</p><span class="benefit-number" aria-hidden="true">0{index + 1}</span></div><h3 class="mt-4 text-xl font-bold text-ink">{benefit.title}</h3><p class="mt-3 text-sm leading-relaxed text-body">{benefit.text}</p><a class="mt-6 inline-block text-sm font-semibold text-accent underline underline-offset-4" href={categoryPath(benefit.category)}>Explore the checks <span aria-hidden="true">↗</span></a></li>)}
      </ul>
    </section>
    <section aria-labelledby="trust-heading" class="trust-panel">
      <div><p class="eyebrow">Proof behind every check</p><h2 id="trust-heading" class="mt-3 text-3xl font-bold text-ink">Know what the result means.</h2><p class="mt-4 text-sm leading-relaxed text-body">Each check explains its rule, sources and limits. Only eligible checks with documented support affect the score. Advisory and experimental findings do not.</p><p class="mt-3 text-sm leading-relaxed text-body">A scan measures signals on your site. It does not test every AI system or promise better search rankings.</p></div>
      <div class="space-y-4"><a class="reference-link" href={docPath('scoring')}>Understand your score <span aria-hidden="true">↗</span></a><a class="reference-link" href={withBase('policy/')}>How we assess the proof <span aria-hidden="true">↗</span></a><a class="reference-link" href={withBase('sources/')}>Explore trusted sources <span aria-hidden="true">↗</span></a><p class="text-xs text-muted">Open source under Apache-2.0. Anyone can review the code.</p></div>
    </section>
    <section aria-labelledby="scan-heading">
      <p class="eyebrow">Get started with Agent Lighthouse</p><h2 id="scan-heading" class="mt-3 text-3xl font-bold text-ink">Your next step starts with a scan.</h2>
      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <div class="self-run-panel"><p class="eyebrow">Open-source project</p><h3 class="mt-4 text-2xl font-bold text-ink">Run Agent Lighthouse yourself.</h3><p class="mt-4 text-sm leading-relaxed text-body">Use your terminal to scan a site. Get an HTML report and a JSON file for your own workflow.</p><pre class="mt-4 overflow-x-auto rounded-lg bg-surface p-4 text-sm text-body"><code>{installCommand}</code></pre><a class="primary-action mt-6" href={docPath('quickstart')}>Run your first scan →</a><p class="mt-4 text-xs text-muted">Free and open source under Apache-2.0.</p></div>
        <div class={panel}><p class="eyebrow">Another way to scan</p><h3 class="mt-4 text-2xl font-bold text-ink">Prefer to scan online?</h3><p class="mt-4 text-sm leading-relaxed text-body">Check your website with Agentic Storefront. Run an AI readiness scan in your browser without terminal setup.</p><a class="secondary-action mt-6" href="https://audit.agenticstorefront.com">Try Agentic Storefront <span aria-hidden="true">↗</span></a><p class="mt-4 text-xs text-muted">An optional online alternative to running Agent Lighthouse yourself.</p></div>
      </div>
    </section>
    <section aria-labelledby="categories-heading" class="space-y-5">
      <h2 id="categories-heading" class={h2}>Explore what the scan checks</h2>
      <p class="text-sm text-muted">Go deeper into a topic. Each check explains what it measures and when it applies.</p>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">{categories.map((category) => <li><a href={categoryPath(category.id)} class={`${card} block h-full text-sm font-semibold text-ink hover:border-brand`}>{category.name}</a></li>)}</ul>
      <a href={withBase('audits/')} class="inline-block text-sm text-accent underline">Browse all website checks →</a>
    </section>
    <!-- Report inspector -->
    <section aria-labelledby="viewer-heading" class="space-y-6">
      <div class={sectionHead}>
        <h2 id="viewer-heading" class={h2}>View a scan report</h2>
        <p class="mt-1 text-sm text-muted">
          Already ran a command-line scan? Open its JSON file to see a score summary. Your file stays in your browser. Use the HTML report for full findings and fix guidance.
        </p>
      </div>

      {/* A real, labelled `<input type="file">` inside the drop target rather
          than a `<div>` that only answers to a pointer: the input is what makes
          this reachable by keyboard, and the drop handling is the enhancement. */}
      {/* Its own border classes rather than `panel`'s: stacking `border` and
          `border-2`, or two border colours, leaves which one wins up to the
          order Tailwind happens to emit them in. */}
      <div
        id="report-dropzone"
        class="rounded-2xl border-2 border-dashed border-border-subtle bg-surface-raised p-5 text-center transition-colors sm:p-6"
      >
        <label for="report-file" class="block text-sm font-semibold text-ink">
          Choose or drop an <code class="font-mono text-accent">agent-lighthouse-report.json</code>
        </label>
        <input
          id="report-file"
          type="file"
          accept="application/json,.json"
          class="mx-auto mt-4 block w-full max-w-md text-sm text-body file:mr-3 file:rounded-lg file:border-0 file:bg-brand file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-brand-soft"
        />
      </div>

      {/* Rendered empty rather than `hidden`, which is the whole point: preflight
          gives `[hidden]` a `display:none`, and a `display:none` element is not in
          the accessibility tree at all. Un-hiding it and writing its text in one
          synchronous block is the pattern that loses the announcement — assistive
          tech has to be observing the region before its content changes. The badge
          status below does the same thing for the same reason. */}
      <p id="report-status" aria-live="polite" class="min-h-5 text-sm text-body"></p>

      <div id="report-output" hidden class={`${panel} space-y-6`}></div>

      <noscript>
        <p class="rounded-xl border border-border-subtle bg-surface-raised/60 p-6 text-sm leading-relaxed text-body">
          <strong class="text-ink">This viewer needs JavaScript.</strong> With
          scripting off there is nothing to read the file with. Run the scan
          with <code class="font-mono text-accent">--output html</code> instead and open
          the report the CLI writes — it is a complete page on its own.
          The <a class="underline hover:text-ink" href={docPath('cli')}>CLI reference</a> lists
          the output flags.
        </p>
      </noscript>
    </section>

    <!-- Badge generator -->
    <section aria-labelledby="badge-heading" class="space-y-6">
      <div class={sectionHead}>
        <h2 id="badge-heading" class={h2}>Share your result</h2>
        <p class="mt-1 text-sm text-muted">
          Create a score badge for your README. Enter your scan result, then copy the snippet. This badge shows the score you enter; it does not verify a scan. <a class="underline hover:text-ink" href={docPath('badge')}>Read the sharing guide</a>.
        </p>
      </div>

      <div class={`${panel} space-y-5`}>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div>
            <label class={label} for="badge-score">Score</label>
            <input id="badge-score" type="number" min="0" max="100" value={DEFAULT_SCORE} class={field} />
          </div>
          <div class="sm:col-span-2">
            <label class={label} for="badge-url">Scanned URL</label>
            <input id="badge-url" type="url" value={DEFAULT_URL} class={field} />
          </div>
        </div>

        <div class="space-y-3 rounded-xl border border-border-subtle bg-surface p-4">
          <div class="flex items-center justify-between gap-4">
            <div id="badge-preview" class="min-h-5 text-sm text-muted"></div>
            {/* Ships hidden and the island reveals it: a Copy button that
                cannot reach a clipboard is worse than no button. */}
            <button
              type="button"
              id="badge-copy"
              hidden
              class="shrink-0 rounded-lg border border-control bg-surface-raised px-3 py-1.5 text-xs font-medium text-body transition-colors hover:bg-hover"
            >Copy</button>
          </div>
          {/* Rendered by the build, so the snippet is right before any script
              runs. Astro escapes the expression, which is what keeps the
              `<!-- Scanned: … -->` line visible instead of being parsed away. */}
          <pre id="badge-markdown" class="overflow-x-auto whitespace-pre-wrap font-mono text-xs text-accent">{defaultBadge}</pre>
          {/* Announced and shown: a confirmation only a screen reader hears
              leaves everyone else guessing whether the button did anything. */}
          <p id="badge-copy-status" aria-live="polite" class="text-xs text-muted"></p>
        </div>

        <table class="w-full border-collapse text-left text-sm">
          <caption class="pb-2 text-left text-xs text-muted">
            Score ranges and badge colours.
          </caption>
          <thead>
            <tr>
              <th scope="col" class="border-b border-border-subtle py-2 pr-4 text-xs font-bold uppercase tracking-wider text-muted">Score</th>
              <th scope="col" class="border-b border-border-subtle py-2 pr-4 text-xs font-bold uppercase tracking-wider text-muted">Colour</th>
              <th scope="col" class="border-b border-border-subtle py-2 text-xs font-bold uppercase tracking-wider text-muted">Meaning</th>
            </tr>
          </thead>
          <tbody>
            {BADGE_BANDS.map((band) => (
              <tr class="border-b border-border-subtle/60">
                <td class="py-2 pr-4 text-body">{band.min}&ndash;{band.max}</td>
                <td class="py-2 pr-4">
                  <span class="inline-flex items-center gap-2 font-mono text-xs text-body">
                    <span
                      class="inline-block size-3 rounded-full"
                      style={`background:#${band.color}`}
                      aria-hidden="true"
                    ></span>
                    {band.color}
                  </span>
                </td>
                <td class="py-2 text-body">{band.meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <noscript>
        <p class="rounded-xl border border-border-subtle bg-surface-raised/60 p-6 text-sm leading-relaxed text-body">
          <strong class="text-ink">The fields above update in your browser.</strong> With
          scripting off the snippet stays at its default. Copy it,
          replace <code class="font-mono text-accent">{DEFAULT_SCORE}</code> with your score
          and the colour with the one its band gets in the table.
        </p>
      </noscript>
    </section>

    <p class="text-sm text-muted">Have a public result? <a class="underline text-accent" href="https://github.com/ForkPoint/agent-lighthouse/issues/new?template=site-score.yml">Share your score and what you changed</a>.</p>
    <section class="closing-cta"><h2 class="text-3xl font-bold text-ink">Make your next website fix count.</h2><p class="mt-3 text-body">Run Agent Lighthouse. See what needs attention.</p><a class="primary-action mt-6" href={docPath('quickstart')}>Run your first scan <span aria-hidden="true">→</span></a><p class="mt-3 text-xs text-muted">Free and open source. Ready for your workflow.</p></section>
  </div>

  <script>
    import { mountBadgeGenerator } from '../islands/badge-generator';
    import { mountReportViewer } from '../islands/report-viewer';

    mountBadgeGenerator();
    mountReportViewer();
  </script>
</Base>
