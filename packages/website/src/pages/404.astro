---
import Base from '../layouts/Base.astro';
import { auditList } from '../lib/registry';
import { docPath, withBase } from '../lib/routes';

/**
 * The page GitHub Pages serves for any address under the site that does not
 * exist. It matters more here than on most sites: every HTML report this tool
 * generates bakes an `evidenceUrl` for each of its audits, so a reader who
 * follows a link written by an older release lands here. It therefore carries
 * the full site chrome — header, search, footer — plus the two routes worth
 * offering by hand.
 *
 * Astro emits this route as `dist/404.html` at the site root, which is the one
 * file GitHub Pages looks for; `trailingSlash: 'always'` does not apply to it.
 */
const audits = auditList();

const action =
  'rounded-lg px-4 py-2 text-sm font-semibold text-ink transition-colors';
---
<Base
  title="Page not found"
  description="This page could not be found. Explore website checks or start a new scan."
>
  <section class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-wider text-accent">404</p>

    <h1 class="mt-4 text-4xl font-black tracking-tight text-ink sm:text-5xl">
      This page is not here
    </h1>

    <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-body">
      This link may be old. A check from an earlier report may have moved or retired. Search this site or browse the current checks below.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href={withBase('audits/')} class:list={[action, 'bg-brand hover:bg-brand-soft']}>
        Browse all {audits.length} checks
      </a>
      <a
        href={withBase('')}
        class:list={[action, 'border border-control bg-surface-raised hover:bg-hover']}
      >Go to the home page</a>
    </div>

    <p class="mt-8 text-sm text-muted">
      Looking for how to run a scan? Start with the <a
        class="underline transition-colors hover:text-ink"
        href={docPath('quickstart')}
      >quickstart</a>.
    </p>
  </section>
</Base>
