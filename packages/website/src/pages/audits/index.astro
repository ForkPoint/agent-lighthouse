---
import Base from '../../layouts/Base.astro';
import AuditCard from '../../components/AuditCard.astro';
import { auditList, categoryList } from '../../lib/registry';
import { categoryPath } from '../../lib/routes';

const audits = auditList();
const categories = categoryList();

// The three tiers `TierBadge` knows, in the order the docs introduce them.
const tiers = [
  { value: 'all', label: 'All tiers' },
  { value: 'scored', label: 'Scored' },
  { value: 'informative', label: 'Advisory' },
  { value: 'experimental', label: 'Experimental' },
];

const pill =
  'rounded-lg border border-slate-700 bg-slate-800 px-3 py-1.5 text-xs font-medium text-slate-200 transition-colors hover:bg-slate-700 aria-pressed:border-brand aria-pressed:bg-brand aria-pressed:text-white';
---
<Base
  title="Audits"
  description="Every audit Agent Lighthouse runs, with the evidence grade and tier it carries."
>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <h1 id="audits-heading" class="text-3xl font-extrabold tracking-tight text-white">Audits</h1>
    <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-300">
      Every check the engine runs, in registry order. Each one links to the dossier that
      states its rule, the evidence behind it, and how the check is implemented.
    </p>

    {/* The controls ship hidden and the island reveals them: with JavaScript off
        they would be inert, while the list below is complete either way. */}
    <section id="audit-controls" hidden aria-label="Filter audits" class="mt-8 space-y-4">
      <div>
        <label for="audit-search" class="block text-xs font-semibold uppercase tracking-wider text-slate-400">
          Search audits
        </label>
        <input
          id="audit-search"
          type="search"
          autocomplete="off"
          placeholder="Search by id, title, description or tag"
          class="mt-2 w-full max-w-xl rounded-lg border border-slate-700 bg-surface-raised px-3 py-2 text-sm text-white placeholder:text-slate-400 focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand"
        />
      </div>

      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by category">
        <button type="button" class={pill} data-filter="category" data-value="all" aria-pressed="true">
          All categories ({audits.length})
        </button>
        {categories.map((category) => (
          <button type="button" class={pill} data-filter="category" data-value={category.id} aria-pressed="false">
            {category.name} ({category.count})
          </button>
        ))}
      </div>

      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by tier">
        {tiers.map((tier) => (
          <button
            type="button"
            class={pill}
            data-filter="tier"
            data-value={tier.value}
            aria-pressed={tier.value === 'all' ? 'true' : 'false'}
          >{tier.label}</button>
        ))}
      </div>
    </section>

    <p class="mt-6 text-sm text-slate-400" aria-live="polite">
      Showing <span id="audit-count" class="font-semibold text-slate-200">{audits.length}</span> of {audits.length} audits
    </p>

    <ul aria-labelledby="audits-heading" class="mt-4 grid gap-3 lg:grid-cols-2">
      {audits.map((audit) => <AuditCard audit={audit} />)}
    </ul>

    <p
      id="audit-empty"
      hidden
      class="mt-4 rounded-xl border border-border-subtle bg-surface-raised/50 p-8 text-center text-sm text-slate-400"
    >No audits match your search.</p>

    <nav aria-label="Categories" class="mt-12 border-t border-border-subtle pt-6">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">Browse by category</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {categories.map((category) => (
          <li>
            <a
              href={categoryPath(category.id)}
              class="inline-block rounded-lg border border-slate-700 bg-slate-800 px-3 py-1.5 text-xs font-medium text-slate-200 transition-colors hover:bg-slate-700 hover:text-white"
            >{category.name} ({category.count})</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  {/* The explorer reads the cards above — the page hands it no data of its own. */}
  <script>
    import { mountExplorer } from '../../islands/audit-explorer';

    mountExplorer();
  </script>
</Base>
