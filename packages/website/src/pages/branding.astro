---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/routes';

const variants = [
  { name: 'Logo for light backgrounds', file: 'rectangle-light', dark: false },
  { name: 'Logo for dark backgrounds', file: 'rectangle-dark', dark: true },
  { name: 'Square icon', file: 'icon', dark: false },
  { name: 'Single-color mark', file: 'mark-white', dark: true },
];
---
<Base title="Agent Lighthouse brand kit" description="Download the Agent Lighthouse logo, icons, social image, and brand guide. Includes SVG, PNG, and print files.">
  <article class="mx-auto max-w-5xl px-4 py-12 sm:px-6" data-pagefind-body>
    <p class="eyebrow">Project resources</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-ink" data-pagefind-meta="title">Agent Lighthouse brand kit</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-body">Use the approved logo when you write about Agent Lighthouse. Get files for websites, presentations, social posts, and print.</p>
    <div class="mt-6 flex flex-wrap gap-4">
      <a class="primary-action" href={withBase('brand/agent-lighthouse-brand-kit.zip')} download>Download the brand kit</a>
      <a class="secondary-action" href={withBase('brand/BRAND.md')}>Read the brand guide</a>
    </div>
    <p class="mt-4 text-sm text-muted">15 logo variants. SVG and PNG files. Favicons, print PDFs, and editable sources.</p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {variants.map(({ name, file, dark }) => (
        <section class="rounded-2xl border border-border-subtle p-6" style={dark ? 'background:#080e1c;color:#f5f7ff' : 'background:#ffffff;color:#101828'}>
          <img src={withBase(`brand/kit/svg/${file}.svg`)} alt={name} width="800" height="240" class="h-40 w-full object-contain" loading="lazy" />
          <h2 class="mt-5 text-lg font-semibold">{name}</h2>
          <p class="mt-3 text-sm"><a class="underline" href={withBase(`brand/kit/svg/${file}.svg`)} download>Download SVG</a> &middot; <a class="underline" href={withBase(`brand/kit/png/${file}.png`)} download>Download PNG</a></p>
        </section>
      ))}
    </div>
    <section class="mt-10 max-w-2xl text-body">
      <h2 class="text-2xl font-bold text-ink">Keep the mark clear</h2>
      <p class="mt-4 leading-relaxed">Keep the logo's proportions and colors. Leave space around the mark. Use the light or dark version for a clear contrast with your background.</p>
      <p class="mt-4 leading-relaxed">The files identify the open-source project. Do not use them to imply a partnership or endorsement.</p>
    </section>
  </article>
</Base>
