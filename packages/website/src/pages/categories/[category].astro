---
import Base from '../../layouts/Base.astro';
import AuditCard from '../../components/AuditCard.astro';
import { auditList, categoryList } from '../../lib/registry';
import { categoryPath, withBase } from '../../lib/routes';

/**
 * One index per category. The registry carries a category's name and its audit
 * count and nothing else — there is no stored description — so the page
 * introduces itself with those facts rather than with prose no source backs.
 */
export function getStaticPaths() {
  const audits = auditList();
  const categories = categoryList();

  return categories.map((category) => ({
    params: { category: category.id },
    props: {
      category,
      categories,
      audits: audits.filter((audit) => audit.category === category.id),
    },
  }));
}

const { category, categories, audits } = Astro.props;
---
<Base
  title={category.name}
  description={`The ${audits.length} Agent Lighthouse audits in ${category.name}.`}
>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <nav aria-label="Breadcrumb" class="text-xs text-slate-400">
      <a class="transition-colors hover:text-white" href={withBase('audits/')}>Audits</a>
      <span aria-hidden="true"> / </span>
      <span>{category.name}</span>
    </nav>

    <h1 id="category-heading" class="mt-3 text-3xl font-extrabold tracking-tight text-white">{category.name}</h1>
    <p class="mt-3 text-sm text-slate-300">
      {audits.length} audits, each linking to the dossier that proves its rule.
    </p>

    <nav aria-label="Categories" class="mt-6">
      <ul class="flex flex-wrap gap-2">
        {categories.map((other) => (
          <li>
            <a
              href={categoryPath(other.id)}
              aria-current={other.id === category.id ? 'page' : undefined}
              class:list={[
                'inline-block rounded-lg border px-3 py-1.5 text-xs font-medium transition-colors',
                other.id === category.id
                  ? 'border-brand bg-brand text-white'
                  : 'border-slate-700 bg-slate-800 text-slate-200 hover:bg-slate-700 hover:text-white',
              ]}
            >{other.name} ({other.count})</a>
          </li>
        ))}
      </ul>
    </nav>

    <ul aria-labelledby="category-heading" class="mt-8 grid gap-3 lg:grid-cols-2">
      {audits.map((audit) => <AuditCard audit={audit} showCategory={false} />)}
    </ul>
  </div>
</Base>
