<section aria-labelledby="scan-help-heading" class="rounded-2xl border border-border-subtle bg-surface-raised p-5 sm:p-6">
  <p class="eyebrow">Ask ForkPoint</p>
  <h2 id="scan-help-heading" class="mt-3 text-3xl font-bold text-ink">Get help with your scan</h2>
  <p class="mt-3 max-w-2xl text-body">Need help running a scan or understanding a finding? Share your website and email so ForkPoint can reply.</p>
  <form id="scan-help-form" action="https://submit.magnifito.com/s/3f4efbc1b148499bbc59fe4bb76b9cf5" method="post" class="mt-6 space-y-5">
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="help-website" class="block text-sm font-semibold text-ink">Website URL</label>
        <input id="help-website" name="website" type="url" required maxlength="2000" placeholder="https://example.com" autocomplete="url" class="mt-2 w-full rounded-lg border border-control bg-surface px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-brand" />
      </div>
      <div>
        <label for="help-email" class="block text-sm font-semibold text-ink">Email</label>
        <input id="help-email" name="email" type="email" required maxlength="254" autocomplete="email" class="mt-2 w-full rounded-lg border border-control bg-surface px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-brand" />
      </div>
    </div>
    <div>
      <label for="help-question" class="block text-sm font-semibold text-ink">Question <span class="font-normal text-muted">(optional)</span></label>
      <textarea id="help-question" name="question" rows="4" maxlength="4000" aria-describedby="help-question-hint" class="mt-2 w-full rounded-lg border border-control bg-surface px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-brand"></textarea>
      <p id="help-question-hint" class="mt-2 text-xs text-muted">Do not include passwords, API keys or private report data.</p>
    </div>
    <p class="text-xs text-muted">ForkPoint uses these details to reply to your request. This does not subscribe you to marketing emails. <a href="https://forkpoint.com/privacy-policy/" class="underline">Privacy policy</a>.</p>
    <button type="submit" class="primary-action disabled:opacity-60">Send request</button>
    <p id="scan-help-status" role="status" aria-live="polite" class="text-sm text-body"></p>
  </form>
</section>

<script>
  import { mountScanHelpForm } from '../islands/scan-help';
  mountScanHelpForm();
</script>
