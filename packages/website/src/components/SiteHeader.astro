---
import SearchDialog from './SearchDialog.astro';
import { docPath, withBase } from '../lib/routes';

/**
 * The sticky site header: wordmark, primary sections, and site search. The
 * search trigger lives here rather than in a slot each page fills: it belongs on
 * all 239 pages, and a slot only every page passes the same thing to is a way
 * for one page to forget. Styling follows the navbar on the page this site
 * replaces — slate-950 at 80% behind a blur, a slate-800 hairline underneath,
 * and the wordmark as white-to-indigo gradient text.
 */
const links = [
  { label: 'Audits', href: withBase('audits/') },
  { label: 'Quickstart', href: docPath('quickstart') },
  { label: 'Policy', href: withBase('policy/') },
];

// A section stays lit while you are anywhere inside it, so the dossier pages
// keep "Audits" marked. `page` is reserved for the exact page; an ancestor
// section gets `true`, which is what ARIA asks for when it is not the page.
const here = Astro.url.pathname;
const currentState = (href: string): 'page' | 'true' | undefined => {
  if (here === href) return 'page';
  return here.startsWith(href) ? 'true' : undefined;
};
---
<header class="sticky top-0 z-50 border-b border-border-subtle bg-surface/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href={withBase('')} class="flex shrink-0 items-center gap-2.5">
      <span class="text-2xl" aria-hidden="true">&#128481;</span>
      <span class="bg-gradient-to-r from-white via-slate-200 to-indigo-300 bg-clip-text text-lg font-extrabold tracking-tight text-transparent">
        Agent Lighthouse
      </span>
    </a>

    <nav aria-label="Main" class="flex items-center gap-4 text-sm font-medium sm:gap-6">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={currentState(link.href)}
          class:list={[
            'transition-colors hover:text-white',
            currentState(link.href) ? 'text-white' : 'text-slate-300',
          ]}
        >{link.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <SearchDialog />
      <a
        href="https://github.com/ForkPoint/agent-lighthouse"
        rel="noopener"
        class="hidden items-center gap-2 rounded-lg border border-slate-700 bg-slate-800 px-3.5 py-1.5 text-sm font-medium text-white transition-colors hover:bg-slate-700 sm:flex"
      >GitHub</a>
    </div>
  </div>
</header>
