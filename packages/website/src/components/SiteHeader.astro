---
import SearchDialog from './SearchDialog.astro';
import { docPath, withBase } from '../lib/routes';

/**
 * Shared header with the approved outlined wordmark, navigation and search.
 * CSS selects one logo for the current theme without exposing duplicate names
 * to assistive technology.
 */
const links = [
  { label: 'Website checks', href: withBase('audits/') },
  { label: 'Scan guide', href: docPath('quickstart') },
  { label: 'Why trust it', href: withBase('policy/') },
];

// A section stays lit while you are anywhere inside it, so the dossier pages
// keep "Audits" marked. `page` is reserved for the exact page; an ancestor
// section gets `true`, which is what ARIA asks for when it is not the page.
const here = Astro.url.pathname;
const currentState = (href: string): 'page' | 'true' | undefined => {
  if (here === href) return 'page';
  return here.startsWith(href) ? 'true' : undefined;
};
---
<header class="sticky top-0 z-50 border-b border-border-subtle bg-surface/80 backdrop-blur-md">
  <div class="mx-auto site-header-inner flex min-h-20 flex-wrap py-3 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href={withBase('')} class="flex shrink-0 items-center gap-2.5">
      <img class="brand-logo-light" src={withBase('brand/kit/svg/rectangle-light-transparent.svg')} width="220" height="66" alt="Agent Lighthouse" />
      <img class="brand-logo-dark" src={withBase('brand/kit/svg/rectangle-dark-transparent.svg')} width="220" height="66" alt="Agent Lighthouse" />
    </a>

    <nav aria-label="Main" class="site-nav flex items-center gap-4 text-sm font-medium sm:gap-6">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={currentState(link.href)}
          class:list={[
            'transition-colors hover:text-ink',
            currentState(link.href) ? 'text-ink' : 'text-body',
          ]}
        >{link.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <SearchDialog />
      <button id="theme-toggle" type="button" hidden aria-label="Use dark mode" class="theme-toggle">Dark mode</button>
      <a
        href="https://github.com/ForkPoint/agent-lighthouse"
        rel="noopener"
        class="primary-action header-cta"
      >GitHub ↗</a>
    </div>
  </div>
</header>

<script>
  import { mountTheme } from '../islands/theme';
  mountTheme();
</script>
