---
/**
 * The documentation sidebar: a one-level-deep tree of links. Entries come in as
 * a prop rather than being read here, so the sidebar has no opinion about where
 * its contents live and never touches the registry.
 */
export interface NavEntry {
  label: string;
  href: string;
  group?: string;
  items?: Array<{ label: string; href: string }>;
}

interface Props {
  nav: NavEntry[];
}

const { nav } = Astro.props;

// Astro is configured with `trailingSlash: 'always'` and every href comes from
// the route helpers, so a plain comparison is enough to find the current page.
const here = Astro.url.pathname;
---
<nav aria-label="Documentation" class="text-sm">
  <ul class="space-y-3">
    {nav.map((entry, index) => (
      <li>
        {entry.group && entry.group !== nav[index - 1]?.group && <p class:list={['mb-3 text-xs font-bold uppercase tracking-wider text-muted', index > 0 && 'mt-7']}>{entry.group}</p>}
        <a
          href={entry.href}
          aria-current={here === entry.href ? 'page' : undefined}
          class:list={[
            entry.group ? 'block text-sm transition-colors hover:text-ink' : 'block text-xs font-bold uppercase tracking-wider transition-colors hover:text-ink',
            here === entry.href ? 'text-brand-soft' : 'text-muted',
          ]}
        >{entry.label}</a>
        {entry.items && entry.items.length > 0 && (
          <ul class="mt-3 space-y-2 border-l border-border-subtle pl-3">
            {entry.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={here === item.href ? 'page' : undefined}
                  class:list={[
                    'block py-0.5 transition-colors hover:text-ink',
                    here === item.href ? 'font-semibold text-brand-soft' : 'text-muted',
                  ]}
                >{item.label}</a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</nav>
