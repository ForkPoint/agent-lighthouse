---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { withBase } from '../lib/routes';

/**
 * The document shell every page shares: head, skip link, header, main, footer.
 * Light and dark themes share semantic colour tokens.
 *
 * The social card metadata (`og:*`, `twitter:*`) and the canonical link live
 * here rather than on each page, so every route carries them and no new page
 * can forget. Their URLs must be absolute — crawlers and social platforms do
 * not resolve relative ones — and they are built from `Astro.site` and the
 * page's own path so the origin is configured in exactly one place.
 */
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Agent Lighthouse is an open-source tool that checks whether AI systems can find, understand, trust and use your website.',
} = Astro.props;

// `Astro.site` is `site` from `astro.config.mjs`, and `Astro.url.pathname`
// already carries the base path, so joining the two yields the published
// address without an origin written anywhere in this package. Dropping `site`
// from the config would silently make every one of these URLs relative, so say
// so instead of shipping the broken card.
if (!Astro.site) {
  throw new Error('`site` must be set in astro.config.mjs: the social card metadata needs absolute URLs.');
}
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Use the square mark for browser icons and the wide PNG for social previews.
const socialImage = new URL(withBase('brand/kit/png/social-card.png'), Astro.site).href;
const socialImageAlt = 'Agent Lighthouse — open-source website checks for AI readiness';
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Apply the saved preference before paint. Storage can be unavailable.
      try {
        const saved = localStorage.getItem('al-theme');
        document.documentElement.dataset.theme = saved === 'light' || saved === 'dark'
          ? saved : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch {
        document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" href={withBase('brand/kit/icons/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('brand/kit/icons/favicon.ico')} sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href={withBase('brand/kit/icons/icon-180.png')} sizes="180x180" />
  </head>
  <body class="min-h-screen antialiased">
    <span id="external-link-hint" class="sr-only">Opens in a new tab</span>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:border focus:border-brand focus:bg-surface-raised focus:p-3 focus:text-ink"
    >Skip to content</a>
    <SiteHeader />
    {/* `tabindex="-1"` so the skip link actually moves focus here, not just the
        scroll position: a plain `<main>` is not a focusable target. This is an
        Astro expression comment, not an HTML one, so it does not ship. */}
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="border-t border-border-subtle mt-16 px-4 py-8 text-center text-xs text-muted">
      <p class="mb-4 text-sm">Agent Lighthouse — open-source checks for website AI readiness.</p>
      Free and open source. Apache-2.0 &middot; <a class="underline" href="https://github.com/ForkPoint/agent-lighthouse">Source on GitHub</a>
      &middot; <a class="underline" href={withBase('branding/')}>Brand kit</a>
      <p class="mt-4">Prefer to scan online? <a class="underline" href="https://audit.agenticstorefront.com">Try Agentic Storefront</a>.</p>
    </footer>
  </body>
</html>

<script>
  import { mountExternalLinks } from '../islands/external-links';
  mountExternalLinks();
</script>
