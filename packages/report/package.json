{
  "name": "@forkpoint/agent-lighthouse-report",
  "version": "0.2.4",
  "description": "Standalone HTML, Markdown, and view-model reporting engine for Agent Lighthouse AI-agent readiness audits",
  "author": "ForkPoint",
  "license": "Apache-2.0",
  "homepage": "https://forkpoint.github.io/agent-lighthouse/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ForkPoint/agent-lighthouse.git",
    "directory": "packages/report"
  },
  "bugs": {
    "url": "https://github.com/ForkPoint/agent-lighthouse/issues"
  },
  "keywords": [
    "forkpoint",
    "agent-lighthouse",
    "lighthouse",
    "reporting",
    "html-report",
    "markdown-report",
    "ai-agents",
    "agentic-web",
    "agent-readiness",
    "ai-seo",
    "audit-report"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@forkpoint/agent-lighthouse-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
