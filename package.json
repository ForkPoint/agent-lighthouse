{
  "name": "agent-lighthouse-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Lighthouse-style audits for AI agents, LLM crawlers, MCP clients, and the agentic web",
  "author": "ForkPoint",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "oxlint .",
    "check:dossiers": "node scripts/check-dossiers.mjs",
    "check:requires": "node --import tsx scripts/check-requires.ts",
    "check:audit-boundaries": "node scripts/check-audit-boundaries.mjs",
    "check:audit-map": "node --import tsx scripts/build-audit-map.ts --check",
    "build:audit-map": "node --import tsx scripts/build-audit-map.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-skill-version.mjs",
    "release": "pnpm build && changeset publish",
    "test:coverage": "vitest run --coverage",
    "test:live": "node --import tsx scripts/test-live-sites.ts",
    "corpus:status": "node --import tsx scripts/corpus-status.ts",
    "corpus:probe": "node --import tsx scripts/probe-corpus.ts",
    "build:sites": "node --import tsx scripts/build-site-list.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "2.1.9",
    "oxlint": "^0.15.10",
    "prettier": "^3.9.9",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.34.6",
  "overrides": {
    "encoding-sniffer": "1.0.2",
    "glob": "12.0.0"
  },
  "pnpm": {
    "overrides": {
      "encoding-sniffer": "1.0.2",
      "glob": "12.0.0"
    }
  }
}
