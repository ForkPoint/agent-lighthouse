{
  "name": "agent-lighthouse-monorepo",
  "version": "0.0.0",
  "private": true,
  "imports": {
    "#core/*": "./packages/core/src/*.ts"
  },
  "description": "Lighthouse-style audits for AI agents, LLM crawlers, MCP clients, and the agentic web",
  "author": "ForkPoint",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r run build",
    "integration:acp": "node packages/integration-testing/dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "oxlint --type-aware .",
    "check:dossiers": "node scripts/audits/check-dossiers.mjs",
    "check:requires": "node --import tsx scripts/audits/check-requires.ts",
    "check:audit-boundaries": "node scripts/audits/check-audit-boundaries.mjs",
    "check:audit-map": "node --import tsx scripts/audits/build-audit-map.ts --check",
    "check:enums": "node --import tsx scripts/quality/check-enums.ts",
    "knip": "knip",
    "check:retired-names": "node --import tsx scripts/quality/check-retired-names.ts",
    "check:package-types": "node scripts/packages/check-package-types.mjs",
    "check:bundle-parity": "node scripts/packages/check-bundle-parity.mjs",
    "smoke:packages": "node scripts/packages/smoke-packages.mjs",
    "build:audit-map": "node --import tsx scripts/audits/build-audit-map.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/plugins/sync-skill-version.mjs",
    "release": "pnpm build && changeset publish",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "knip": "6.42.1",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-api": "npm:typescript@6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.6",
  "overrides": {
    "encoding-sniffer": "1.0.2",
    "launch-editor@<2.14.2": "2.14.2",
    "glob": "12.0.0",
    "undici@>=7.0.0 <7.29.1": "7.29.1",
    "ip-address@<10.7.4": "10.7.4",
    "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
    "hono@<4.13.11": "4.13.11",
    "devalue@<5.9.3": "5.9.3",
    "proxy-addr@<2.0.8": "2.0.8",
    "qs@<6.16.0": "6.16.0",
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "smol-toml@<1.9.0": "1.9.0",
    "source-map-js@<1.2.2": "1.2.2"
  }
}
