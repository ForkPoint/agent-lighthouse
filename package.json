{
  "name": "agent-lighthouse-monorepo",
  "version": "0.0.0",
  "private": true,
  "imports": {
    "#core/*": "./packages/core/src/*.ts"
  },
  "description": "Lighthouse-style audits for AI agents, LLM crawlers, MCP clients, and the agentic web",
  "author": "ForkPoint",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "oxlint .",
    "check:dossiers": "node scripts/check-dossiers.mjs",
    "check:requires": "node --import tsx scripts/check-requires.ts",
    "check:audit-boundaries": "node scripts/check-audit-boundaries.mjs",
    "check:audit-map": "node --import tsx scripts/build-audit-map.ts --check",
    "check:enums": "node --import tsx scripts/check-enums.ts",
    "build:audit-map": "node --import tsx scripts/build-audit-map.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-skill-version.mjs",
    "release": "pnpm build && changeset publish",
    "test:coverage": "vitest run --coverage",
    "test:live": "node --import tsx scripts/test-live-sites.ts",
    "corpus:status": "node --import tsx scripts/corpus-status.ts",
    "corpus:probe": "node --import tsx scripts/probe-corpus.ts",
    "build:sites": "node --import tsx scripts/build-site-list.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "5.0.3",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-api": "npm:typescript@6.0.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.34.6",
  "overrides": {
    "encoding-sniffer": "1.0.2",
    "glob": "12.0.0",
    "undici@>=7.0.0 <7.29.1": "7.29.1",
    "ip-address@<10.7.1": "10.7.1",
    "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
    "hono@<4.13.7": "4.13.7",
    "devalue@<5.9.3": "5.9.3",
    "proxy-addr@<2.0.8": "2.0.8",
    "qs@<6.16.0": "6.16.0",
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "smol-toml@<1.9.0": "1.9.0",
    "source-map-js@<1.2.2": "1.2.2"
  },
  "pnpm": {
    "overrides": {
      "encoding-sniffer": "1.0.2",
      "glob": "12.0.0",
      "undici@>=7.0.0 <7.29.1": "7.29.1",
      "ip-address@<10.7.1": "10.7.1",
      "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
      "hono@<4.13.7": "4.13.7",
      "devalue@<5.9.3": "5.9.3",
      "proxy-addr@<2.0.8": "2.0.8",
      "qs@<6.16.0": "6.16.0",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "smol-toml@<1.9.0": "1.9.0",
      "source-map-js@<1.2.2": "1.2.2"
    }
  }
}
